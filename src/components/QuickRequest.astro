---
import { siteData } from "../data/site";
---

<div class="quick-request" id="pedido-rapido">
  <div class="quick-request-intro">
    <span class="quick-request-eyebrow">PEDIDO DIRETO</span>
    <h4>Prepare sua mensagem de atendimento</h4>
    <p>Escolha o serviço e informe onde você está. O WhatsApp abre com tudo organizado para a equipe.</p>
  </div>

  <form id="quick-request-form" class="quick-request-form" aria-label="Preparar mensagem de atendimento" data-whatsapp-base={siteData.whatsappBaseUrl}>
    <label for="request-service">Qual serviço você precisa? <span aria-hidden="true">*</span></label>
    <select id="request-service" name="servico" required>
      <option value="" disabled selected>Selecione uma opção</option>
      <option value="Abertura de veículo">Abertura de veículo</option>
      <option value="Chave automotiva">Chave automotiva</option>
      <option value="Abertura de porta residencial">Abertura de porta residencial</option>
      <option value="Troca ou instalação de fechadura">Troca ou instalação de fechadura</option>
      <option value="Cópia de chaves">Cópia de chaves</option>
      <option value="Outro serviço">Outro serviço</option>
    </select>

    <label for="request-neighborhood">Seu bairro em Joinville <span class="quick-request-optional">(opcional)</span></label>
    <input id="request-neighborhood" name="bairro" type="text" maxlength="80" autocomplete="address-level3" placeholder="Ex.: Jarivatuba" />

    <label for="request-details">Algum detalhe importante? <span class="quick-request-optional">(opcional)</span></label>
    <textarea id="request-details" name="detalhes" rows="2" maxlength="200" placeholder="Ex.: chave ficou dentro do carro"></textarea>

    <button type="submit" class="quick-request-submit" data-track="quick-request-whatsapp">
      Abrir mensagem no WhatsApp <span aria-hidden="true">↗</span>
    </button>
    <p class="quick-request-note">Nenhuma informação é enviada por este site. Você confirma a mensagem no WhatsApp.</p>
    <noscript><p class="quick-request-note">Ative o JavaScript para preencher a mensagem automaticamente ou use o botão de WhatsApp abaixo.</p></noscript>
  </form>
</div>

<script>
  const form = document.getElementById("quick-request-form") as HTMLFormElement | null;
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const service = String(data.get("servico") || "").trim();
    if (!service) return;
    const neighborhood = String(data.get("bairro") || "").trim().slice(0, 80);
    const details = String(data.get("detalhes") || "").trim().slice(0, 200);
    const message = [
      "Olá! Encontrei o site do Chaveiro Mota e gostaria de solicitar atendimento em Joinville.",
      "Serviço: " + service,
      ...(neighborhood ? ["Bairro: " + neighborhood] : []),
      ...(details ? ["Detalhes: " + details] : [])
    ].join("\n");

    const url = String(form.dataset.whatsappBase || "") + "?text=" + encodeURIComponent(message);
    const opened = window.open(url, "_blank", "noopener,noreferrer");
    if (!opened) window.location.assign(url);
  });
</script>

<style>
  .quick-request {
    margin-top: 26px;
    padding: clamp(20px, 3vw, 30px);
    color: #fff;
    background: #111417;
    border-top: 4px solid var(--color-accent-yellow);
    border-radius: var(--radius-md);
  }
  .quick-request-intro { margin-bottom: 20px; }
  .quick-request-eyebrow {
    display: block; font-size: .72rem; font-weight: 800; letter-spacing: .12em;
    color: var(--color-accent-yellow); margin-bottom: 8px;
  }
  .quick-request h4 {
    font: 700 clamp(1.18rem, 2vw, 1.4rem)/1.3 var(--font-heading);
    letter-spacing: -.02em; margin: 0 0 8px;
  }
  .quick-request-intro p {
    font-size: .91rem; line-height: 1.55; color: var(--color-text-light-muted);
  }
  .quick-request-form { display: grid; gap: 9px; }
  .quick-request-form label {
    font-size: .84rem; line-height: 1.35; font-weight: 700; margin-top: 8px;
  }
  .quick-request-optional {
    font-size: .76rem; font-weight: 400; color: var(--color-text-light-muted);
  }
  .quick-request-form select,
  .quick-request-form input,
  .quick-request-form textarea {
    width: 100%; min-width: 0; min-height: 48px; padding: 12px 13px;
    border: 1.5px solid #8B98A6; border-radius: var(--radius-sm);
    background: #fff; color: #111417; font: 500 .9375rem/1.45 var(--font-body);
  }
  .quick-request-form textarea { resize: vertical; min-height: 76px; }
  .quick-request-form :is(select,input,textarea):focus-visible,
  .quick-request-submit:focus-visible {
    outline: 3px solid var(--color-accent-yellow); outline-offset: 3px;
  }
  .quick-request-submit {
    width: 100%; min-height: 50px; display: flex; align-items: center;
    justify-content: space-between; gap: 10px; margin-top: 10px;
    padding: 12px 16px; background: var(--color-accent-yellow);
    color: #111417; border: 1px solid var(--color-accent-yellow);
    border-radius: var(--radius-sm); font: 700 .93rem/1.35 var(--font-body);
    cursor: pointer; transition: background .15s ease, transform .15s ease;
  }
  .quick-request-submit:hover { background: var(--color-accent-yellow-hover); transform: translateY(-1px); }
  .quick-request-submit span { font-size: 1.2rem; }
  .quick-request-note {
    font-size: .77rem; line-height: 1.5; color: var(--color-text-light-muted); margin-top: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .quick-request-submit { transition: none; transform: none !important; }
  }
</style>
