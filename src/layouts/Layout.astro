        class="btn btn-primary"
        data-track="mobile-bar-whatsapp"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span>WhatsApp</span>
      </a>
    </div>

    <!-- Script de Interação Acessível: Drawer, Escape, Focus Trap, Inert e Breakpoint -->
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const btnAbrir = document.getElementById("btn-abrir-menu");
        const btnFechar = document.getElementById("btn-fechar-menu");
        const drawer = document.getElementById("menu-lateral");
        const drawerContent = drawer?.querySelector(".mobile-drawer-content");

        // Elementos irmãos de fundo para isolamento estrito via atributo 'inert'
        const backgroundElements = [
          document.getElementById("skip-link"),
          document.getElementById("cabecalho"),
          document.getElementById("conteudo-principal"),
          document.getElementById("site-footer"),
          document.getElementById("mobile-bottom-bar")
        ].filter(Boolean) as HTMLElement[];

        function getFocusableElements(): HTMLElement[] {
          if (!drawerContent) return [];
          const selector = 'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';
          return Array.from(drawerContent.querySelectorAll<HTMLElement>(selector)).filter(
            (el) => !el.hasAttribute("disabled") && el.offsetParent !== null
          );
        }

        function abrirDrawer() {
          if (!drawer || !btnAbrir) return;
          drawer.classList.add("is-open");
          drawer.setAttribute("aria-hidden", "false");
          btnAbrir.setAttribute("aria-expanded", "true");
          document.body.classList.add("menu-open");
          document.body.style.overflow = "hidden";

          // Tornar todos os elementos irmãos de fundo inertes
          backgroundElements.forEach((el) => el.setAttribute("inert", ""));

          // Foco inicial no botão de fechar
          btnFechar?.focus();
        }

        function fecharDrawer(targetFocusEl?: HTMLElement | null) {
          if (!drawer || !btnAbrir) return;
          if (!drawer.classList.contains("is-open")) return;

          drawer.classList.remove("is-open");
          drawer.setAttribute("aria-hidden", "true");
          btnAbrir.setAttribute("aria-expanded", "false");
          document.body.classList.remove("menu-open");
          document.body.style.overflow = "";

          // Remover inércia de todos os elementos irmãos
          backgroundElements.forEach((el) => el.removeAttribute("inert"));

          // Restaurar foco a elemento visível adequado
          if (targetFocusEl && targetFocusEl.offsetParent !== null) {
            targetFocusEl.focus();
          } else if (btnAbrir && btnAbrir.offsetParent !== null) {
            btnAbrir.focus();
          } else {
            // Se cruzou o breakpoint e o botão de menu está oculto, devolve o foco para a marca
            const brandEl = document.querySelector<HTMLElement>(".brand-link");
            brandEl?.focus();
          }
        }

        btnAbrir?.addEventListener("click", abrirDrawer);
        btnFechar?.addEventListener("click", () => fecharDrawer());

        // Fechar ao clicar fora (no backdrop)
        drawer?.addEventListener("click", (e) => {
          if (e.target === drawer) {
            fecharDrawer();
          }
        });

        // Contenção estrita de foco (Trap) e tecla Escape
        document.addEventListener("keydown", (e) => {
          if (!drawer?.classList.contains("is-open")) return;

          if (e.key === "Escape") {
            e.preventDefault();
            fecharDrawer();
            return;
          }

          if (e.key === "Tab") {
            const focusables = getFocusableElements();
            if (focusables.length === 0) return;

            const firstElement = focusables[0];
            const lastElement = focusables[focusables.length - 1];

            if (e.shiftKey) {
              if (document.activeElement === firstElement || !drawerContent?.contains(document.activeElement)) {
                e.preventDefault();
                lastElement.focus();
              }
            } else {
              if (document.activeElement === lastElement || !drawerContent?.contains(document.activeElement)) {
                e.preventDefault();
                firstElement.focus();
              }
            }
          }
        });

        // Fechar ao clicar em qualquer âncora interna do drawer
        drawer?.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => {
            fecharDrawer();
          });
        });

        // Fechar o menu ao cruzar o breakpoint de desktop (992px)
        const desktopMq = window.matchMedia("(min-width: 992px)");
        const handleBreakpointChange = (e: MediaQueryListEvent | MediaQueryList) => {
          if (e.matches && drawer?.classList.contains("is-open")) {
            // Em desktop, fecha o drawer e foca na marca ou primeiro link de nav visível
            const firstNav = document.querySelector<HTMLElement>(".nav-desktop a");
            fecharDrawer(firstNav);
          }
        };

        if (desktopMq.addEventListener) {
          desktopMq.addEventListener("change", handleBreakpointChange);
        } else {
          desktopMq.addListener(handleBreakpointChange);
        }

        // Pontos de medição de cliques (sem cookies ou rastreadores externos)
        document.querySelectorAll("[data-track]").forEach((el) => {
          el.addEventListener("click", () => {
            const trackId = el.getAttribute("data-track");
            if (window && (window as any).dataLayer) {
              (window as any).dataLayer.push({ event: "cta_click", ctaId: trackId });
            }
          });
        });
      });
    </script>
  </body>
</html>
