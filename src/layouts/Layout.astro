---
import { siteData, buildWhatsAppUrl } from "../data/site";
import "../styles/global.css";

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  isNotFound?: boolean;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title = siteData.seoPages.home.title,
  description = siteData.seoPages.home.description,
  canonicalPath,
  isNotFound = false,
  breadcrumbs
} = Astro.props;

// Origem explícita de publicação via variável de ambiente ou Astro.site.
// Em ambiente local, se não definido, mantém undefined para não inventar domínio.
const siteOrigin = process.env.SITE_URL || process.env.PUBLIC_SITE_URL || (Astro.site ? Astro.site.origin : undefined);
const isPublishedOrigin = Boolean(siteOrigin && !siteOrigin.includes("localhost") && !siteOrigin.includes("127.0.0.1"));

const targetPath = canonicalPath || Astro.url.pathname;
const canonicalUrl = siteOrigin ? new URL(targetPath, siteOrigin).href : undefined;
const ogImageUrl = siteOrigin ? new URL("/assets/images/og-image.jpg", siteOrigin).href : "/assets/images/og-image.jpg";

// Schema.org com modelagem factual
const schemaOrgData: any[] = [
  {
    "@context": "https://schema.org",
    "@type": "Locksmith",
    "@id": siteOrigin ? `${siteOrigin}/#locksmith` : undefined,
    "name": siteData.name,
    "description": description,
    "url": siteOrigin || undefined,
    "telephone": siteData.phoneRaw,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Rua Agulhas Negras, 1530",
      "addressLocality": "Joinville",
      "addressRegion": "SC",
      "addressCountry": "BR"
    },
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "09:00",
        "closes": "12:00",
        "description": "Expediente da loja física matutino"
      },
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "14:00",
        "closes": "18:00",
        "description": "Expediente da loja física vespertino"
      }
    ],
    "paymentAccepted": "Credit Card, Debit Card",
    "currenciesAccepted": "BRL",
    "areaServed": {
      "@type": "City",
      "name": "Joinville"
    }
  }
];

if (breadcrumbs && breadcrumbs.length > 0) {
  schemaOrgData.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbs.map((b, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": b.name,
      "item": siteOrigin ? new URL(b.url, siteOrigin).href : b.url
    }))
  });
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Homologação / Staging: noindex até publicação oficial autorizada -->
    {
      isNotFound || !isPublishedOrigin || process.env.ENABLE_INDEXING !== "true" ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow" />
      )
    }

    <!-- Canonical autorreferente por URL quando houver origem pública -->
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <!-- Favicon e Ícones -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />

    <!-- Tipografia: Sora e Inter do Google Fonts com preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Metatags Open Graph -->
    <meta property="og:type" content="website" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={siteData.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrgData.length === 1 ? schemaOrgData[0] : schemaOrgData)} />
  </head>
  <body>
