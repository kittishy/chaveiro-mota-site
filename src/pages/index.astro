---
import Layout from "../layouts/Layout.astro";
import { siteData, buildWhatsAppUrl } from "../data/site";

const pageMeta = siteData.seoPages.home;
---

<Layout
  title={pageMeta.title}
  description={pageMeta.description}
  canonicalPath="/"
>
  <!-- Hero Section Editorial (55% Texto / 45% Foto, Carvão Neutro e Destaque Amarelo) -->
  <section class="hero" id="inicio" aria-labelledby="hero-heading">
    <div class="container">
      <div class="hero-grid">
        <!-- Coluna de Conteúdo Textual -->
        <div class="hero-content">
          <div class="hero-badge-strip">
            <span class="regime-bullet" aria-hidden="true"></span>
            <span>Atendimento no Jarivatuba e em toda Joinville</span>
          </div>

          <h1 class="hero-title" id="hero-heading">
            Chaveiro <span class="text-accent">24 horas</span> em Joinville
          </h1>

          <p class="hero-description">
            {siteData.hero.supportText}
          </p>

          <div class="hero-actions">
            <a
              href={buildWhatsAppUrl(siteData.hero.ctaWhatsappMessage)}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary"
              data-track="hero-whatsapp"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
              <span>{siteData.hero.ctaWhatsappText}</span>
            </a>
            <a href={siteData.telHref} class="btn btn-secondary-light" data-track="hero-phone">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>{siteData.hero.ctaPhoneText}</span>
            </a>
          </div>

          <!-- Faixa Operacional Factual em Linha Leve -->
          <div class="hero-regime-row">
            <div class="regime-item">
              <span class="regime-bullet" aria-hidden="true"></span>
              <div>
                <strong>Plantão 24h:</strong> Atendimento móvel para urgências de tranca e veículos em Joinville.
              </div>
            </div>
            <div class="regime-item">
              <span class="regime-bullet" aria-hidden="true"></span>
              <div>
                <strong>Loja Física:</strong> Balcão no Jarivatuba • Seg. a sex., 9h–12h e 14h–18h.
              </div>
            </div>
          </div>
        </div>

        <!-- Mídia do Hero Protagonista sem Embalagens Pesadas -->
        <figure class="hero-media-wrapper">
          <picture>
            <source srcset={siteData.hero.image.srcsetWebp} sizes={siteData.hero.image.sizes} type="image/webp" />
            <source srcset={siteData.hero.image.srcsetJpg} sizes={siteData.hero.image.sizes} type="image/jpeg" />
            <img
              src={siteData.hero.image.jpg}
              alt={siteData.hero.image.alt}
              width={siteData.hero.image.width}
              height={siteData.hero.image.height}
              fetchpriority="high"
              loading="eager"
              class="hero-media-img"
            />
          </picture>
          <figcaption class="image-caption">Imagem ilustrativa de bancada técnica</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Seção de Serviços em Duas Faixas Abertas (Sem Cards Pesados e com Links Detalhados) -->
  <section class="section" id="servicos" aria-labelledby="servicos-heading">
    <div class="container">
      <div class="section-header-compact">
        <span class="section-tag">Especialidades Técnicas</span>
        <h2 class="section-title" id="servicos-heading">Serviços Automotivos e Residenciais</h2>
        <p class="section-subtitle">
          Atendimento no local para veículos trancados e residências, chaves codificadas e troca de fechaduras em Joinville.
        </p>
      </div>

      <div class="services-open-container">
        <!-- Faixa 1: Automotivo -->
        {
          (() => {
            const auto = siteData.services[0];
            return (
              <article class="service-strip" id={auto.id}>
                <div class="service-details">
                  <span class="service-eyebrow">{auto.eyebrow}</span>
                  <h3 class="service-heading">{auto.h2Title}</h3>
                  <p class="service-lead">{auto.description}</p>

                  <ul class="service-specs-list" aria-label={`Especialidades em ${auto.title}`}>
                    {auto.items.map((item) => (
                      <li class="service-spec-item">
                        <svg class="spec-check-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                        </svg>
                        <div>
                          <span class="spec-name">{item.title}:</span>
                          <span class="spec-desc"> {item.description}</span>
                        </div>
                      </li>
                    ))}
                  </ul>

                  <div class="service-action-wrap">
                    <a
                      href={buildWhatsAppUrl(auto.whatsappMessage)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn-primary"
                      data-track="service-cta-automotivo"
                    >
                      <span>{auto.ctaLabel}</span>
                    </a>
                    <a href={auto.pageUrl} class="btn-outline-dark">
                      <span>Ver detalhes de chaveiro automotivo</span>
                      <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>

                <figure class="service-media-figure">
                  <picture>
                    <source srcset={auto.image.srcsetWebp} sizes={auto.image.sizes} type="image/webp" />
                    <source srcset={auto.image.srcsetJpg} sizes={auto.image.sizes} type="image/jpeg" />
                    <img
                      src={auto.image.jpg}
                      alt={auto.image.alt}
                      width={auto.image.width}
                      height={auto.image.height}
                      loading="lazy"
                      decoding="async"
                      class="service-media-img"
                    />
                  </picture>
                  <figcaption class="image-caption">Imagem ilustrativa do serviço automotivo</figcaption>
                </figure>
              </article>
            );
          })()
        }

        <!-- Faixa 2: Residencial (Com inversão visual no desktop) -->
        {
          (() => {
            const res = siteData.services[1];
            return (
              <article class="service-strip service-strip-alt" id={res.id}>
                <div class="service-details">
                  <span class="service-eyebrow">{res.eyebrow}</span>
                  <h3 class="service-heading">{res.h2Title}</h3>
                  <p class="service-lead">{res.description}</p>

                  <ul class="service-specs-list" aria-label={`Especialidades em ${res.title}`}>
                    {res.items.map((item) => (
                      <li class="service-spec-item">
                        <svg class="spec-check-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                        </svg>
                        <div>
                          <span class="spec-name">{item.title}:</span>
                          <span class="spec-desc"> {item.description}</span>
                        </div>
                      </li>
                    ))}
                  </ul>

                  <div class="service-action-wrap">
                    <a
                      href={buildWhatsAppUrl(res.whatsappMessage)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn-primary"
                      data-track="service-cta-residencial"
                    >
                      <span>{res.ctaLabel}</span>
                    </a>
                    <a href={res.pageUrl} class="btn-outline-dark">
                      <span>Ver detalhes de chaveiro residencial</span>
                      <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>

                <figure class="service-media-figure">
                  <picture>
                    <source srcset={res.image.srcsetWebp} sizes={res.image.sizes} type="image/webp" />
                    <source srcset={res.image.srcsetJpg} sizes={res.image.sizes} type="image/jpeg" />
                    <img
                      src={res.image.jpg}
                      alt={res.image.alt}
                      width={res.image.width}
                      height={res.image.height}
                      loading="lazy"
                      decoding="async"
                      class="service-media-img"
                    />
                  </picture>
                  <figcaption class="image-caption">Imagem ilustrativa do serviço residencial</figcaption>
                </figure>
              </article>
            );
          })()
        }
      </div>
    </div>
  </section>

  <!-- Loja Física como Assinatura Amarela da Marca -->
  <section class="store-signature-section" id="loja" aria-labelledby="loja-heading">
    <div class="container">
      <div class="store-signature-grid">
        <!-- Coluna Esquerda: Endereço, Horários e Mapa -->
        <div class="store-main-col">
          <span class="store-badge-dark">{siteData.storeServices.eyebrow}</span>
          <h2 class="store-signature-heading" id="loja-heading">
            Loja física na Rua Agulhas Negras, 1530
          </h2>

          <div class="store-address-box">
            <div>{siteData.fullAddress}</div>
            <div class="store-address-sub">Bairro Jarivatuba — Joinville / SC</div>
          </div>

          <div style="margin-bottom: 24px;">
            <a
              href={siteData.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-dark"
              data-track="store-maps-btn"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
                <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
              </svg>
              <span>Abrir localização no Google Maps</span>
            </a>
          </div>

          <!-- Horários em Linhas Semânticas e Escaneáveis (Preferência Julia) -->
          <div class="store-hours-block" role="region" aria-label="Expedientes de atendimento">
            <div class="store-hour-card">
              <span class="store-hour-title">{siteData.hours.storeTitle}</span>
              <span class="store-hour-days">{siteData.hours.storeDays}</span>
              <span class="store-hour-times">{siteData.hours.storeTimes}</span>
            </div>
            <div class="store-hour-card">
              <span class="store-hour-title">{siteData.hours.emergencyTitle}</span>
              <span class="store-hour-times">{siteData.hours.emergencyTimes}</span>
            </div>
          </div>

          <div>
            <a href="/copia-de-chaves-joinville/" class="btn-secondary-on-yellow">
              <span>Ver serviços de cópia de chaves no balcão</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <!-- Coluna Direita: 4 Módulos Leves Interativos de Balcão e Oficina -->
        <div class="store-counter-col">
          <h3 class="counter-col-title">Serviços de Balcão e Oficina</h3>
          
          <div class="store-modules-grid" role="list" aria-label="Serviços de balcão e oficina">
            {siteData.storeModules.map((mod) => (
              <a
                href={buildWhatsAppUrl(mod.whatsappMessage)}
                target="_blank"
                rel="noopener noreferrer"
                class="store-module-card"
                role="listitem"
                data-track={`store-module-${mod.id}`}
              >
                <div class="module-header">
                  <div class="module-icon" aria-hidden="true">
                    {mod.icon === "key" && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                        <path d="M21 2l-2 2m-1.5 1.5L16 7l-1.5-1.5-1.5 1.5 1.5 1.5-3 3a6 6 0 1 0 2.8 2.8l7.2-7.2V2h-3.5z" />
                        <circle cx="7.5" cy="16.5" r="1.5" />
                      </svg>
                    )}
                    {mod.icon === "lock" && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                      </svg>
                    )}
                    {mod.icon === "scissors" && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                        <circle cx="6" cy="6" r="3" />
                        <circle cx="6" cy="18" r="3" />
                        <line x1="20" y1="4" x2="8.12" y2="15.88" />
                        <line x1="14.47" y1="14.48" x2="20" y2="20" />
                        <line x1="8.12" y1="8.12" x2="12" y2="12" />
                      </svg>
                    )}
                    {mod.icon === "document" && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="16" y1="13" x2="8" y2="13" />
                        <line x1="16" y1="17" x2="8" y2="17" />
                        <polyline points="10 9 9 9 8 9" />
                      </svg>
                    )}
                  </div>
                  <strong class="module-title">{mod.title}</strong>
                </div>
                <p class="module-desc">{mod.description}</p>
                <span class="module-action-link" aria-hidden="true">
                  Consultar via WhatsApp →
                </span>
              </a>
            ))}
          </div>

          <div class="payment-notes">
            <span class="payment-label">Pagamento aceito: </span>
            <span class="payment-value">{siteData.paymentMethods.join(" e ")}. Orçamento sem compromisso.</span>
          </div>

          <div style="margin-top: 20px;">
            <a
              href={buildWhatsAppUrl(siteData.storeServices.whatsappMessage)}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-dark btn-sm"
              data-track="store-whatsapp-btn"
            >
              <span>{siteData.storeServices.ctaLabel}</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Orientação para Solicitação e FAQ Agrupados -->
  <section class="section" id="faq" aria-labelledby="faq-section-heading">
    <div class="container">
      <div class="section-header-compact">
        <span class="section-tag">Orientações e Dúvidas</span>
        <h2 class="section-title" id="faq-section-heading">Como Solicitar e Perguntas Frequentes</h2>
        <p class="section-subtitle">
          Instruções práticas para atendimento rápido e respostas claras para as principais dúvidas.
        </p>
      </div>

      <div class="guidance-faq-grid">
        <!-- Bloco Compacto: Para Solicitar Atendimento -->
        <div class="guidance-col">
          <h3 class="service-heading" style="font-size: 1.35rem;">
            {siteData.requestGuidance.title}
          </h3>
          <p class="service-lead" style="margin-bottom: 8px;">
            {siteData.requestGuidance.subtitle}
          </p>

          <div class="guidance-steps">
            {siteData.requestGuidance.items.map((item) => (
              <div class="guidance-step-card">
                <div class="guidance-num">{item.number}</div>
                <div class="guidance-content">
                  <strong>{item.label}</strong>
                  <p>{item.desc}</p>
                </div>
              </div>
            ))}
          </div>

          <div style="margin-top: 24px;">
            <a
              href={buildWhatsAppUrl("Olá! Gostaria de solicitar um orçamento para atendimento de chaveiro.")}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary"
              data-track="guidance-whatsapp"
            >
              <span>Chamar no WhatsApp agora</span>
            </a>
          </div>
        </div>

        <!-- Bloco: Dúvidas Frequentes (FAQ) -->
        <div class="faq-col">
          <h3 class="service-heading" style="font-size: 1.35rem; margin-bottom: 20px;">
            Dúvidas mais comuns
          </h3>

          <div class="faq-accordion-wrap">
            {siteData.faqs.map((faq) => (
              <details class="faq-item">
                <summary class="faq-question">
                  <span>{faq.question}</span>
                  <svg class="faq-icon-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </summary>
                <div class="faq-answer">
                  <p>{faq.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
